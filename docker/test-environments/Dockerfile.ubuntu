# Ubuntu-based test environment for development scripts
FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18 (LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs

# Install Python 3.12
RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Create python3 symlink for compatibility
RUN ln -sf /usr/bin/python3.12 /usr/bin/python3
RUN ln -sf /usr/bin/python3.12 /usr/bin/python

# Install pnpm globally
RUN npm install -g pnpm@latest

# Install uv (optional Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"

# Create working directory
WORKDIR /app

# Copy package.json first (for Docker layer caching)
COPY package.json ./

# Set up test user (optional - for testing non-root scenarios)
RUN useradd -m -s /bin/bash testuser
RUN chown -R testuser:testuser /app

# Default command for interactive testing
CMD ["/bin/bash"]

# Labels for identification
LABEL testing.environment="ubuntu"
LABEL testing.node.version="18"
LABEL testing.python.version="3.12"
LABEL testing.purpose="landscape-show-dev-scripts"